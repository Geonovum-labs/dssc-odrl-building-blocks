    {
      "title": "Generic ODRL location policy example",
      "description": "Data-transfer policy requiring spatial aggregation to a hexagonal grid with a defined minimum resolution.\n",
      "snippets": [
        {
          "language": "json",
          "ref": "http://localhost:9090/register/_sources/odrl/location-privacy/patterns/ldp6-aggregate-hexgrid/examples/example.json",
          "url": "http://localhost:9090/register/build-local/tests/geonovum/dssc/odrl/location-privacy/patterns/ldp6-aggregate-hexgrid/example_1_1.json",
          "sizeBytes": 827,
          "code": "{\n  \"@context\": [\n    \"https://www.w3.org/ns/odrl.jsonld\",\n    {\n      \"lp\": \"https://wetransform.eu/ns/odrl/location-privacy#\",\n      \"geofence\": \"https://wetransform.eu/ns/vc/geofence#\",\n      \"vc\": \"https://www.w3.org/2018/credentials#\"\n    }\n  ],\n  \"@type\": \"odrl:Set\",\n  \"uid\": \"urn:policy:ldp-aggregate-res8\",\n  \"permission\": [\n    {\n      \"target\": \"urn:asset:protected-resource\",\n      \"action\": \"use\",\n      \"duty\": [\n        {\n          \"action\": \"lp:aggregate\",\n          \"constraint\": [\n            {\n              \"leftOperand\": \"lp:algo\",\n              \"operator\": \"eq\",\n              \"rightOperand\": \"lp:HexGridAgg\"\n            },\n            {\n              \"leftOperand\": \"lp:hexGridRes\",\n              \"operator\": \"gte\",\n              \"rightOperand\": 8\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}\n"
        }
      ]
    },
