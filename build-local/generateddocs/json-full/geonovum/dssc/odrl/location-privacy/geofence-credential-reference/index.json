  "annotatedSchema": "$schema: https://json-schema.org/draft/2020-12/schema\n$id: https://example.org/building-blocks/odrl/location-privacy/geofence-credential-reference/schema.json\ntitle: Participant Geofence Credential Reference\ntype: object\nrequired:\n- credentialSubject\nproperties:\n  credentialSubject:\n    type: object\n    required:\n    - id\n    - geofence\n    properties:\n      id:\n        type: string\n      geofence:\n        type: object\n        required:\n        - URL\n        - hash\n        properties:\n          URL:\n            type: string\n            format: uri\n          hash:\n            type: string\n            pattern: ^[A-Fa-f0-9]{64}$\n        additionalProperties: true\n    additionalProperties: true\nadditionalProperties: true\n"
