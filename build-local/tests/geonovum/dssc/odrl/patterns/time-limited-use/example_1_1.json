{
  "@context": {
    "edc": "https://w3id.org/edc/v0.0.1/ns/",
    "@vocab": "http://www.w3.org/ns/odrl.jsonld"
  },
  "@type": "Offer",
  "target": "urn:example:dataset:1",
  "permission": [
    {
      "action": "use",
      "constraint": {
        "and": [
          {
            "leftOperand": "edc:inForceDate",
            "operator": "gt",
            "rightOperand": {
              "@value": "contractAgreement",
              "@type": "edc:dateExpression"
            }
          },
          {
            "leftOperand": "edc:inForceDate",
            "operator": "lt",
            "rightOperand": {
              "@value": "contractAgreement + 100d",
              "@type": "edc:dateExpression"
            }
          }
        ]
      }
    }
  ]
}