{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/building-blocks/odrl/obligation/schema.json",
  "title": "ODRL Obligation / Duty Rule",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "@id": {
      "type": "string"
    },
    "target": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "@id"
          ],
          "properties": {
            "@id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "constraint": {
      "oneOf": [
        {
          "oneOf": [
            {
              "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/constraint-atomic/schema.json"
            },
            {
              "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/constraint-logical/schema.json"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/constraint-atomic/schema.json"
              },
              {
                "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/constraint-logical/schema.json"
              }
            ]
          }
        }
      ]
    },
    "duty": {
      "oneOf": [
        {
          "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/obligation/schema.json"
        },
        {
          "type": "array",
          "items": {
            "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/obligation/schema.json"
          }
        }
      ]
    }
  },
  "additionalProperties": true
}