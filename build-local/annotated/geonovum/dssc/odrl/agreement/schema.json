{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/building-blocks/odrl/agreement/schema.json",
  "title": "ODRL Agreement for Dataspace Protocol",
  "type": "object",
  "required": [
    "@type"
  ],
  "properties": {
    "@context": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "@id": {
      "type": "string"
    },
    "@type": {
      "oneOf": [
        {
          "const": "Agreement"
        },
        {
          "const": "odrl:Agreement"
        }
      ]
    },
    "profile": {
      "type": "string"
    },
    "target": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "assigner": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
    "permission": {
      "type": "array",
      "items": {
        "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/permission/schema.json"
      }
    },
    "prohibition": {
      "type": "array",
      "items": {
        "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/prohibition/schema.json"
      }
    },
    "obligation": {
      "type": "array",
      "items": {
        "$ref": "http://localhost:9090/register/build-local/annotated/geonovum/dssc/odrl/obligation/schema.json"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "permission"
      ]
    },
    {
      "required": [
        "prohibition"
      ]
    },
    {
      "required": [
        "obligation"
      ]
    }
  ],
  "additionalProperties": true
}