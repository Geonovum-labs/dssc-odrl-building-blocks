{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/building-blocks/odrl/constraint-logical/schema.json",
  "title": "ODRL Logical Constraint",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "and"
      ]
    },
    {
      "required": [
        "or"
      ]
    },
    {
      "required": [
        "xone"
      ]
    }
  ],
  "properties": {
    "and": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "../constraint-atomic/schema.json"
          },
          {
            "$ref": "../constraint-logical/schema.json"
          }
        ]
      }
    },
    "or": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "../constraint-atomic/schema.json"
          },
          {
            "$ref": "../constraint-logical/schema.json"
          }
        ]
      }
    },
    "xone": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "../constraint-atomic/schema.json"
          },
          {
            "$ref": "../constraint-logical/schema.json"
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
